# ESP-IDF build output
build/
build_host/
sdkconfig
sdkconfig.old

# Local credentials — NEVER COMMIT. WiFi PSK and AetherSDR host live here.
sdkconfig.defaults.local

# Managed components are fetched from the registry; dependencies.lock IS committed.
managed_components/

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store
compile_commands.json
build_usbnet/
build_usbdiag/
# One build directory per radio's firmware (tools/release.sh), and any other.
build_*/

# OTA image signing key -- NEVER commit. Losing it means no more updates
# for devices already in the field; leaking it means anyone can sign one.
ota_signing_key.pem
*_signing_key.pem

# Staged OTA artefacts. Published on the orphan firmware branch, never on
# main -- 1.7 MB per release has no business in this history.
firmware/

# tools/mkrender.py output: regenerated at will, and --photo composites
# contain other people's photographs.
docs/marketing/

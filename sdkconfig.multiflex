# The multiflex firmware: a FlexRadio 6000/8000 over its own API, with no
# computer in between (VFO_RADIO=multiflex) -- the knob as one of the radio's
# MultiFlex stations.
#
# WiFi only, without the USB networking of sdkconfig.usbnet: the knob reaches
# the radio over WiFi, and the USB link has no route to it -- the knob is the
# DHCP server there, on a link with no gateway. Leaving TinyUSB out also frees
# the internal RAM its buffers take, and keeps the serial console on the cable.

# The radio's uncompressed receive audio is ~180 datagrams a second, beside
# its meters and the hidden panadapter's: room for a burst while the task is
# busy with a status line.
CONFIG_LWIP_UDP_RECVMBOX_SIZE=16

# Opus in fixed point, as the svxconnect firmware runs it: its floating-point
# encoder does not keep up with real time on the ESP32-S3.
CONFIG_OPUS_FLOATING_POINT=n

# A web SDR beside the radio (components/sdr_rx) and its test on the web
# page, beside the radio's own sockets, the web page's and the log's: 10 ran
# out with a browser open.
CONFIG_LWIP_MAX_SOCKETS=16
# ...and every address its name stands for, to try each in turn. Safe only
# without SNTP: lwIP's cache then writes them all where SNTP keeps one.
CONFIG_LWIP_DNS_MAX_HOST_IP=4

# SmartLink (components/flex_client/smartlink.c): a radio reached through
# FlexRadio's service presents a certificate of its own, self-signed, which
# the knob pins on first use as AetherSDR does -- so esp-tls must let a
# connection go without a CA. Every other connection still names one (the
# certificate bundle), and is still verified.
CONFIG_ESP_TLS_INSECURE=y
CONFIG_ESP_TLS_SKIP_SERVER_CERT_VERIFY=y
# AES in software, as the aethersdr build: the engine's DMA takes its bounce
# buffers from internal RAM, and with WiFi, Opus and two TLS connections up
# there is none to spare.
CONFIG_MBEDTLS_HARDWARE_AES=n

# --- internal RAM, for a SmartLink session with a headset -----------------
# v1.18.1 ran one with 10-12 kB of internal RAM free, and a log client with a
# browser beside it took that to 4.7 kB: the flex task stood still for 10 s
# and the radio dropped the session. The WiFi driver sends and receives from
# internal RAM only; it is kept for that. (The flex task's 10 s report says
# what is left: free, at its lowest, in one piece.) LVGL's unused pixel
# formats gave the first ~48 kB back; they are off for every firmware now,
# in sdkconfig.defaults.
#
# malloc() above 1 kB from PSRAM first, internal RAM the fallback (IDF's
# default: above 16 kB). That moves the TLS connections' esp_tls_t (2,008
# bytes each, two kept open -- hence not 2 kB), lwIP's full-size TCP
# segments (what a log client and the web page queue), HTTP buffers. What has
# to be internal asks for it by capability and stays: the WiFi driver's DMA
# buffers, task stacks, FreeRTOS, I2S and SPI DMA, the draw buffers; and a
# segment is copied into the driver's own buffer to be sent. Not
# SPIRAM_TRY_ALLOCATE_WIFI_LWIP: that one forces 16 static transmit buffers
# (~26 kB) on, and hands segments to the driver by reference.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024
# mDNS (vfo-knob.local, a radio's .local name) -- its task's stack and what
# it allocates -- and NVS's cache in PSRAM: neither is touched with the flash
# cache off, and mDNS's task writes no flash.
CONFIG_MDNS_TASK_CREATE_FROM_SPIRAM=y
CONFIG_MDNS_MEMORY_ALLOC_SPIRAM=y
CONFIG_NVS_ALLOCATE_CACHE_IN_SPIRAM=y

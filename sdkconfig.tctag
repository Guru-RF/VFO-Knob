# The TailChaser Tag firmware: the knob listening, through its own microphone,
# for the callsign tag under a TailChaser repeater's audio, and showing who
# was heard (VFO_RADIO=tctag).
#
# WiFi only, without the USB networking of sdkconfig.usbnet, as the Clock: the
# time servers are on the internet, and the USB link has no route there.
# Leaving TinyUSB out also keeps the serial console on the cable.

# AES in software, as every firmware: the engine's DMA takes its bounce buffers
# from internal RAM.
CONFIG_MBEDTLS_HARDWARE_AES=n

# The web page's sessions and the log's beside the time's, as the Clock's.
CONFIG_LWIP_MAX_SOCKETS=16

# Shared, non-secret defaults. Local WiFi/host overrides go in
# sdkconfig.defaults.local (gitignored).

CONFIG_IDF_TARGET="esp32s3"

# --- clock / memory -------------------------------------------------------
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
# 120M QIO is rejected by the static assert in mspi_timing_tuning.c when
# paired with 80 MHz octal PSRAM. We stream nothing from flash at runtime, so
# 80 MHz costs nothing.
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# Static .bss to PSRAM. Internal RAM is the binding constraint on this board --
# LVGL draw buffers, WiFi descriptors, two I2S channels and the WebSocket
# client all want it, and the failure mode is obscure (a WebSocket upgrade that
# cannot read its response, or a bare TCP connect that times out while the
# server is demonstrably healthy). Static buffers have no reason to compete:
# only DMA needs to be internal.
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
# WiFi/lwIP buffers stay in internal RAM. Moving them to PSRAM was measured
# and made things WORSE (10.7 kB internal free at TCI start, against 38 kB
# without it), and it cannot relocate the static RX descriptors anyway --
# which is the allocation that actually competes with the draw buffers.
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# --- partitions -----------------------------------------------------------
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# --- console over the native USB-Serial-JTAG (no external UART bridge) ----
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# --- scheduling -----------------------------------------------------------
# A 20 ms touch poll and a 5 ms encoder backstop are both meaningless at the
# default 10 ms tick.
CONFIG_FREERTOS_HZ=1000
# Quarantine lwIP on core 0 so nothing it does can jitter the encoder, haptic
# or display timing on core 1. (There is no Kconfig symbol for the WiFi task's
# core in IDF 5.5; it follows the lwIP affinity in practice.)
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
CONFIG_ESP_TIMER_TASK_AFFINITY_CPU0=y

# --- watchdogs ------------------------------------------------------------
# Panic deliberately: a reboot drops the TCI socket, and AetherSDR unkeys the
# radio when a PTT-owning client disconnects. A watchdog reboot is a SAFE
# outcome for this device.
CONFIG_ESP_TASK_WDT_TIMEOUT_S=5
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_INT_WDT=y
CONFIG_ESP_INT_WDT_TIMEOUT_MS=300
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y

# --- LVGL -----------------------------------------------------------------
# Large digits for the frequency readout. Montserrat is proportional, so the
# readout shimmers slightly at tuning speed; a tabular-figure subset is the
# proper fix and is a later refinement.
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_ATTRIBUTE_FAST_MEM_USE_IRAM=y
CONFIG_LV_DEF_REFR_PERIOD=16
CONFIG_LV_USE_PERF_MONITOR=n

# --- OTA: signed images, no Secure Boot ------------------------------------
# The signature is verified before an update is accepted, but nothing is burned
# into eFuse: the board stays ordinarily flashable and nothing here is
# irreversible. This is integrity, not licensing -- it stops a corrupt or
# hostile image reaching a radio, which is the real risk once updates are
# pushed to other people's transceivers.
CONFIG_SECURE_SIGNED_APPS_NO_SECURE_BOOT=y
CONFIG_SECURE_SIGNED_ON_UPDATE_NO_SECURE_BOOT=y
CONFIG_SECURE_BOOT_SIGNING_KEY="ota_signing_key.pem"
# A new image must prove itself before it is made permanent. Paired with the
# boot-loop guard: the same 20 s "this boot looks healthy" timer that clears
# the safe-mode counter is what marks the app valid, so an update that panics
# on startup rolls back to the previous slot by itself.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# Root certificates for https://github.com and the redirect to
# objects.githubusercontent.com that release assets are actually served from.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

# Mbed TLS works out of PSRAM. RSA-3072 signature verification on an OTA image
# needs several kB of MPI scratch, and on this board internal RAM is the scarce
# resource -- it failed with MBEDTLS_ERR_MPI_ALLOC_FAILED and rejected a valid,
# correctly signed image as "signature bad". Nothing here is touched by DMA.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# The ADS-B Radar firmware: a radar of the aircraft round the knob, from an
# ADS-B feed on the internet or a receiver of one's own (VFO_RADIO=adsb).
#
# WiFi only, without the USB networking of sdkconfig.usbnet: the feeds are on
# the internet, and the USB link has no route there. Leaving TinyUSB out also
# keeps the serial console on the cable.

# AES in software, as every firmware: the engine's DMA takes its bounce buffers
# from internal RAM.
CONFIG_MBEDTLS_HARDWARE_AES=n

# The feed's connection and the route's beside the web page's and the log's.
CONFIG_LWIP_MAX_SOCKETS=16

# The aircraft's labels: their callsign and flight level, small.
CONFIG_LV_FONT_MONTSERRAT_12=y

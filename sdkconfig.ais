# The AIS Radar firmware: a radar of the ships round the knob, from
# AISStream.io's stream or an AIS-catcher of one's own (VFO_RADIO=ais).
#
# WiFi only, without the USB networking of sdkconfig.usbnet: the stream is on
# the internet, and the USB link has no route there. Leaving TinyUSB out also
# keeps the serial console on the cable.

# AES in software, as every firmware: the engine's DMA takes its bounce buffers
# from internal RAM.
CONFIG_MBEDTLS_HARDWARE_AES=n

# The stream's connection, or the AIS-catcher's, beside the web page's and the log's.
CONFIG_LWIP_MAX_SOCKETS=16

# The ships' labels: their name and speed, small.
CONFIG_LV_FONT_MONTSERRAT_12=y
